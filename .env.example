# ==================== PRODUCTION ENVIRONMENT VARIABLES ====================
# Copy this file to .env and fill in with actual production values
# NEVER commit .env file with real credentials to version control!
# Use: docker-compose -f docker-compose.prod.yml --env-file .env up -d

# Database Configuration
DB_ROOT_PASSWORD=secure_root_password_change_me
DB_NAME=userdb_production
DB_USER=produser
DB_PASSWORD=secure_user_password_change_me

# Application Configuration (optional)
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC
SPRING_PROFILES_ACTIVE=prod

